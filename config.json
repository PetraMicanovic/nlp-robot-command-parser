{
  "model": {
    "name": "t5-small",
    "prefix": "translate command to actions: ",
    "max_input_len": 64,
    "max_target_len": 128,
    "num_beams": 4
  },
  "model_t5_base": {
    "name": "t5-base",
    "prefix": "translate command to actions: ",
    "max_input_len": 64,
    "max_target_len": 128,
    "num_beams": 4
  },
  "model_mbart": {
    "name": "facebook/mbart-large-50",
    "prefix": "translate command to actions: ",
    "max_input_len": 64,
    "max_target_len": 128,
    "num_beams": 4
  },
  "training": {
    "seed": 42,
    "num_epochs": 20,
    "train_batch_size": 32,
    "eval_batch_size": 64,
    "learning_rate": 1e-4,
    "weight_decay": 0.01,
    "warmup_ratio": 0.05,
    "output_dir": "checkpoints/t5_small",
    "early_stopping_patience": 3
  },
  "training_t5_base": {
    "seed": 42,
    "num_epochs": 20,
    "train_batch_size": 16,
    "eval_batch_size": 32,
    "learning_rate": 5e-5,
    "weight_decay": 0.01,
    "warmup_ratio": 0.05,
    "output_dir": "checkpoints/t5-base",
    "early_stopping_patience": 3
  },
  "training_mbart": {
      "seed": 42,
      "num_epochs": 10,
      "train_batch_size": 2,
      "eval_batch_size": 4,
      "learning_rate": 3e-5,
      "weight_decay": 0.01,
      "warmup_ratio": 0.05,
      "output_dir": "checkpoints/mbart",
      "early_stopping_patience": 3,
      "gradient_accumulation_steps": 8,
      "gradient_checkpointing": true,
      "optim": "adamw_bnb_8bit",
      "dataloader_pin_memory": false
  },
  "results": {
    "t5_small_dir": "results/t5-small",
    "t5_base_dir": "results/t5-base",
    "mbart_dir": "results/mbart"
  },
  "asr": {
    "whisper_model": "small",
    "language": "sr",
    "tts_lang": "sr",
    "audio_path": "/tmp/command.mp3",
    "audio_dir": "audio_commands",
    "n_asr_samples": 100
  },
  "data": {
    "scan_split": "simple",
    "scan_base_path": "data/scan",
    "n_eval": 200,
    "n_error_analysis": 500,
    "lang": "sr"
  },
  "valid_actions": [
    "I_WALK",
    "I_RUN",
    "I_JUMP",
    "I_LOOK",
    "I_TURN_LEFT",
    "I_TURN_RIGHT"
  ],
  "valid_actions_sr": [
    "I_HODAJ",
    "I_TRCI",
    "I_SKOCI",
    "I_GLEDAJ",
    "I_OKRENI_LIJEVO",
    "I_OKRENI_DESNO"
  ]
}